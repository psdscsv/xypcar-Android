<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- 图传背景图像 -->
    <ImageView
        android:id="@+id/iv_video_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 主布局 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 顶部：设备名、连接按钮、设置按钮等 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/device_name_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:drawable/editbox_background"
                android:hint="输入蓝牙名称"
                android:padding="8dp"
                android:singleLine="true"
                android:text="ESP32_Car"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:textSize="16sp" />

            <Button
                android:id="@+id/connect_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_connect_ripple"
                android:paddingHorizontal="16dp"
                android:text="连接"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/disconnect_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_disconnect_ripple"
                android:enabled="false"
                android:paddingHorizontal="16dp"
                android:text="断开"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/reset_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_reset_ripple"
                android:text="归零"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="设置"
                android:scaleType="centerCrop"
                android:src="@raw/ic_settings" />
        </LinearLayout>

        <!-- 状态栏 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="❌ 未连接"
            android:textColor="@color/text_status_disconnected"
            android:textSize="16sp" />

        <!-- 摇杆容器（用于承载 Fragment） -->
        <FrameLayout
            android:id="@+id/joystick_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</FrameLayout>