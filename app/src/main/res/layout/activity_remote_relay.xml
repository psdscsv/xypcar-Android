<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#1A1A2E">

    <!-- 地图 -->
    <com.amap.api.maps.MapView
        android:id="@+id/remote_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 右侧面板 - 带滚动 -->
    <ScrollView
        android:id="@+id/right_panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:scrollbars="vertical"
        android:background="#CC000000"
        android:padding="8dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部标题和切换按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📡 远程控制"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_toggle_drive_mode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_manage"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="驾驶模式" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_my_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本机ID: --"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="状态: 未连接"
                android:textColor="#FFAA44"
                android:textSize="14sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="连接"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_disconnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="断开"
                    android:enabled="false"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目标设备ID"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
            <EditText
                android:id="@+id/et_target_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:drawable/editbox_background"
                android:padding="6dp"
                android:singleLine="true"
                android:textColor="#000000"
                android:textSize="12sp"
                android:hint="输入对方设备ID" />

            <TextView
                android:id="@+id/tv_remote_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="等待数据..."
                android:textColor="#00FFAA"
                android:textSize="12sp"
                android:padding="4dp"
                android:background="#33000000"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 目标点列表"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

            <!-- 关键修改：添加 scrollbars 和 nestedScrollingEnabled -->
            <ListView
                android:id="@+id/lv_remote_waypoints"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:background="#33000000"
                android:padding="2dp"
                android:divider="#444444"
                android:dividerHeight="1dp"
                android:choiceMode="singleChoice"
                android:scrollbars="vertical"
                android:nestedScrollingEnabled="true"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_add_remote_pos"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="标记远程位置"
                    android:textSize="11sp"
                    android:backgroundTint="#4A6A9A"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp" />

                <Button
                    android:id="@+id/btn_delete_remote_point"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="删除选中"
                    android:textSize="11sp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="4dp" />

                <Button
                    android:id="@+id/btn_clear_remote_points"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="清空"
                    android:textSize="11sp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕹️ 遥控指令"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <Button
                    android:id="@+id/btn_forward"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="前进"
                    android:textSize="11sp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp" />
                <Button
                    android:id="@+id/btn_backward"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="后退"
                    android:textSize="11sp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="2dp" />
                <Button
                    android:id="@+id/btn_left"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="左转"
                    android:textSize="11sp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="2dp" />
                <Button
                    android:id="@+id/btn_right"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="右转"
                    android:textSize="11sp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="2dp" />
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="停止"
                    android:textSize="11sp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <Button
                    android:id="@+id/btn_start_auto"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="启动导航"
                    android:textSize="11sp"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp" />
                <Button
                    android:id="@+id/btn_stop_auto"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="停止导航"
                    android:textSize="11sp"
                    android:backgroundTint="#9C27B0"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="6dp"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 日志"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#33000000"
                android:padding="4dp">
                <TextView
                    android:id="@+id/tv_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="【日志】\n"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- 摇杆覆盖层（驾驶模式） -->
    <RelativeLayout
        android:id="@+id/joystick_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#88000000">

        <com.psd.xypcar.control.JoystickView
            android:id="@+id/joystick_left"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="40dp" />

        <com.psd.xypcar.control.JoystickView
            android:id="@+id/joystick_right"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp" />

        <ImageButton
            android:id="@+id/btn_exit_drive_mode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="退出驾驶模式" />

        <TextView
            android:id="@+id/tv_drive_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="40dp"
            android:text="速度: 0.0  转向: 0.0"
            android:textColor="#00FFAA"
            android:textSize="18sp"
            android:background="#CC000000"
            android:padding="8dp" />
    </RelativeLayout>
</LinearLayout>