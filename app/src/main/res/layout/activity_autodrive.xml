<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========== 原有主布局 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1A2E"
        android:orientation="horizontal">

        <!-- 左侧：地图区域（含悬浮按钮） -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.amap.api.maps.MapView
                android:id="@+id/autodrive_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/btn_locate"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="100dp"
                android:background="@raw/ic_locate" />
        </FrameLayout>

        <!-- 右侧面板 -->
        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Tab 切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_control"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#4CAF50"
                    android:text="控制"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/tab_points"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#4A6A9A"
                    android:text="目标点"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <!-- 内容容器 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 控制页（可滑动） -->
                <ScrollView
                    android:id="@+id/scroll_control"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="状态: 未开始"
                            android:textColor="#00FFAA"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_current_target"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="目标: 无"
                            android:textColor="#FFAA44"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="速度: 0.0 m/s"
                            android:textColor="#00FFAA"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_turn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="转向: 0.0 °/s"
                            android:textColor="#FFAA44"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_ble_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="BLE: 未连接"
                            android:textColor="#FFAA44"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_start_nav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="#4CAF50"
                            android:text="开始导航"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btn_stop_nav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#F44336"
                            android:enabled="false"
                            android:text="停止导航"
                            android:textColor="#FFFFFF" />

                        <!-- 新增：大按钮模式切换 -->
                        <Button
                            android:id="@+id/btn_toggle_big_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#0A0AC0"
                            android:text="🔲 大按钮模式"
                            android:textColor="#FFFFFF" />

                        <Button
                            android:id="@+id/btn_remote_control"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:backgroundTint="#9C27B0"
                            android:text="📡 远程连接"
                            android:textColor="#FFFFFF" />

                    </LinearLayout>
                </ScrollView>

                <!-- 目标点列表页 -->
                <LinearLayout
                    android:id="@+id/page_points"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="目标点列表"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <ListView
                        android:id="@+id/lv_waypoints"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#33000000"
                        android:choiceMode="singleChoice"
                        android:divider="#444444"
                        android:dividerHeight="1dp"
                        android:padding="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_add_current_pos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#4A6A9A"
                            android:text="标记自己"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_delete_selected"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#F44336"
                            android:text="删除选中"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_clear_points"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FF5722"
                            android:text="清空所有"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_save_waypoints"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:backgroundTint="#4CAF50"
                            android:text="保存"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_load_waypoints"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#FF9800"
                            android:text="加载"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btn_export_waypoints"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:backgroundTint="#9C27B0"
                            android:text="导出"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ========== 大按钮覆盖层 ========== -->
    <RelativeLayout
        android:id="@+id/overlay_big_buttons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- 关闭按钮 -->
        <ImageButton
            android:id="@+id/btn_close_overlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="关闭大按钮模式" />

        <!-- 状态信息 -->
        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:text="状态: 未开始"
            android:textColor="#00FFAA"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/overlay_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/overlay_status"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="目标: 无"
            android:textColor="#FFAA44"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/overlay_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/overlay_target"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="速度: 0.0 m/s"
            android:textColor="#00FFAA"
            android:textSize="20sp" />

        <!-- 两大按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <Button
                android:id="@+id/overlay_btn_start"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:text="开始导航"
                android:textSize="40sp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/overlay_btn_stop"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:text="停止导航"
                android:textSize="40sp"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:enabled="false" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>